# =============================================================================
# DGA Parallel Detection - .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
env/
.venv/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# --- Data (large files - download separately via Git LFS clone) ---
data/*.csv
data/*.pkl
data/*.gz
data/*.json
data/english_dictionary.txt
data/*.marisa
!data/.gitkeep

# --- Results (regenerated by benchmarks) ---
results/metrics.json
results/plots/*.png
results/plots/*.pdf
!results/.gitkeep
!results/plots/.gitkeep

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter (if used for exploration) ---
.ipynb_checkpoints/
*.ipynb
!P3_Experimental_Report.ipynb

# --- Logs ---
*.log
# B6 carve-out: ARM/QEMU build + parity logs are dissertation evidence
!results/rq3/logs/*.log
venv_wsl2/
Python-3.11.9.tgz
Python-3.11.9/
data/DGA-Detection-Training-Dataset/
data/DGA_domains_dataset/
# pre-fetched platform wheels for docker builds; not committed
wheels/*
!wheels/.keep
