# =============================================================================
# full: gates + harnesses image (B6 Step 1).
# The complete pinned environment (requirements.txt: sklearn 1.8.0 etc.) with
# code, tests, models and preprocess artifacts baked in. Used for:
#   - the five gate suites under cgroup profiles (test_parallel, test_onnx,
#     test_feature_kernel, test_features, test_boundary)
#   - RQ1 adaptive-vs-static bounded datum under Profile A
#   - Linux-fork spawn-economics re-checks (B6 Step 3)
#   - tl2cgen compiled-.so bench (B6 Step 4; Windows-blocked since B3)
# Base pinned by the same multi-arch index digest as serve-onnx.
# =============================================================================
FROM python@sha256:721dc13fd1be0a771e54b72097634291d628d0007dee9da777e2ce676a9c998f

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
# pip 24.0 (bundled) trips over inconsistent PEP-658 metadata hashes on some
# older PyPI wheels ("THESE PACKAGES DO NOT MATCH THE HASHES ... unknown
# package"); current pip verifies correctly.
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# gcc for tl2cgen native compilation (B6 Step 4); after the pip layer to
# keep the expensive dependency cache intact.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*

COPY . .

CMD ["python", "-m", "pytest", "tests/", "-q"]
